rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function teacher(){return request.auth != null && request.auth.uid == 'TXh88MO29fVS0jMLeCLcBLLxx172';}
  function student(){return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';}
  function validCode(code){return code.matches('PSI(00[1-9]|0[1-5][0-9]|060)');}
  function appOpen(){return exists(/databases/$(database)/documents/settings/application) && get(/databases/$(database)/documents/settings/application).data.open == true;}
  function sessionPath(uid){return /databases/$(database)/documents/studentSessions/$(uid);}
  function participantPath(code){return /databases/$(database)/documents/participants/$(code);}
  match /settings/application {
   allow get: if request.auth != null;
   allow list,create,update,delete: if teacher();
  }
  match /studentSessions/{uid} {
   allow get: if teacher() || (student() && request.auth.uid == uid);
   allow list: if teacher();
   allow create: if teacher() || (student() && appOpen() && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['code','createdAt'])
     && validCode(request.resource.data.code)
     && request.resource.data.createdAt == request.time
     && getAfter(participantPath(request.resource.data.code)).data.ownerUid == uid);
   allow update: if teacher();
   allow delete: if teacher();
  }
  match /participants/{code} {
   // Alunos só podem ler vaga vazia ou a própria; consultas gerais são exclusivas do professor.
   allow get: if teacher() || (student() && validCode(code) && (!exists(participantPath(code)) || resource.data.ownerUid == request.auth.uid));
   allow list: if teacher();
   allow create: if teacher() || (student() && appOpen() && validCode(code)
     && request.resource.data.keys().hasOnly(['ownerUid','started','completed','createdAt'])
     && request.resource.data.ownerUid == request.auth.uid
     && request.resource.data.started == {} && request.resource.data.completed == {}
     && request.resource.data.createdAt == request.time
     && getAfter(sessionPath(request.auth.uid)).data.code == code);
   allow update: if teacher() || (student() && appOpen() && validCode(code)
     && resource.data.ownerUid == request.auth.uid
     && get(sessionPath(request.auth.uid)).data.code == code
     && request.resource.data.ownerUid == resource.data.ownerUid
     && request.resource.data.createdAt == resource.data.createdAt
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['started','completed'])
     && request.resource.data.started.keys().hasOnly(['wasi','fdt','ravlt','d2r'])
     && request.resource.data.completed.keys().hasOnly(['wasi','fdt','ravlt','d2r']));
   allow delete: if teacher();
  }
 }
}
